# Copiar a deploy/.env y ajustar. deploy/.env NO se versiona (.gitignore).

# --- PostgreSQL ---
POSTGRES_USER=resto
POSTGRES_PASSWORD=change-me-in-local
POSTGRES_DB=resto_business
POSTGRES_PORT=5432

# --- Fase 1 (Auth API): se completan al implementar autenticación ---
# AUTH__ISSUER=http://localhost:5001
# AUTH__SIGNING_KEY_PATH=/run/secrets/jwt-signing.key
# Auth__Authority=http://backend-auth:8080
# Auth__Audience=resto-business

# --- Gateway (nginx): único punto de entrada publicado al host ---
# Puerto donde escucha nginx (frontend + auth + business detrás, ruteado por path;
# ver deploy/nginx/nginx.conf). Acceder desde otra máquina de la LAN: http://<ip-del-host>:<GATEWAY_PORT>
GATEWAY_PORT=80

# --- CORS (Auth API y Business API) ---
# Orígenes permitidos para pegarle directo a una API sin pasar por nginx (Swagger,
# herramientas). Con nginx, frontend y APIs comparten origin y esto no interviene.
# Hasta 3 orígenes (CORS_ORIGIN_0/1/2); agregar más índices en docker-compose.yml si hace falta.
CORS_ORIGIN_0=http://localhost
# CORS_ORIGIN_1=http://192.168.1.111
# CORS_ORIGIN_2=https://mi-dominio.example

# --- Frontend: config runtime (window.__env, ver frontend/public/env.example.js) ---
# Vacío (default) = rutas relativas al origin actual, resueltas por nginx. Solo
# hace falta setearlas para apuntar el frontend a APIs servidas fuera de nginx.
# API_BASE_URL=http://otra-api.example
# AUTH_BASE_URL=http://otra-api.example
